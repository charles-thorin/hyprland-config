// One bar along the bottom of the screen:
//   [Knight: power menu]  ·  [mask workspaces]  ·····  date  ·····  [open apps]
{
  "layer": "top",
  "position": "bottom",
  "height": 42,
  "spacing": 0,
  "reload_style_on_change": true,   // edits to style.css apply instantly

  "modules-left":   ["custom/power", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right":  ["wlr/taskbar"],

  "custom/power": {
    "format": " ",
    "tooltip-format": "Power menu",
    "on-click": "wlogout -b 5"
  },

  "hyprland/workspaces": {
    // Only existing workspaces are shown, so this part grows and shrinks.
    // The masks come from icons/ (see style.css).
    "format": "{icon}",
    "format-icons": { "default": " " },
    "sort-by-number": true,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },

  "clock": {
    "format": "{:%A %d %B  ·  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#e8ecf2'><b>{}</b></span>",
        "weekdays": "<span color='#8a93a3'>{}</span>",
        "days":     "<span color='#c9d0db'>{}</span>",
        "today":    "<span color='#bfe0ff'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // Open windows, with their app icons. Click to focus, middle-click to close.
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 26,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  }
}
